    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.2.12",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/plugin": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
