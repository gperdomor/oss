    }
  },
  "dependencies": {
    "@nx-tools/core": "workspace:*"
  },
  "peerDependencies": {
    "@nx/devkit": ">=18.0.0 <24.0.0",
    "prisma": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "ts-node": "^10.0.0",
    "tslib": "catalog:",
    "tsx": "catalog:"
  },
  "peerDependenciesMeta": {
    "tsx": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "executors": "./executors.json",
  "generators": "./generators.json"
